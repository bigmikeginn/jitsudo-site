---
interface Props {
  action?: string;
  heading?: string;
}

const { action = '#', heading } = Astro.props;

const inputClass = 'w-full bg-surface-2 border border-white/15 text-white text-sm px-4 py-3 placeholder-white/30 focus:outline-none focus:border-accent transition-colors';
const labelClass = 'block text-xs tracking-[0.15em] uppercase text-white/55 mb-2';
---

<div>
  {heading && (
    <h3 class="font-display text-2xl uppercase tracking-wide mb-8">{heading}</h3>
  )}
  <form action={action} method="POST" class="space-y-5" novalidate>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <label for="cf-name" class={labelClass}>Name *</label>
        <input id="cf-name" type="text" name="name" required autocomplete="name" placeholder="Your full name" class={inputClass} />
      </div>
      <div>
        <label for="cf-phone" class={labelClass}>Phone</label>
        <input id="cf-phone" type="tel" name="phone" autocomplete="tel" placeholder="(905) 000-0000" class={inputClass} />
      </div>
    </div>
    <div>
      <label for="cf-email" class={labelClass}>Email *</label>
      <input id="cf-email" type="email" name="email" required autocomplete="email" placeholder="you@example.com" class={inputClass} />
    </div>
    <div>
      <label for="cf-subject" class={labelClass}>I'm interested in</label>
      <select id="cf-subject" name="subject" class={`${inputClass} cursor-pointer`}>
        <option value="" disabled selected>Select a program...</option>
        <option value="karate">Karate</option>
        <option value="bjj">Brazilian Jiu-Jitsu</option>
        <option value="kids">Kids Programs</option>
        <option value="trial">Free Trial Class</option>
        <option value="other">General Inquiry</option>
      </select>
    </div>
    <div>
      <label for="cf-message" class={labelClass}>Message</label>
      <textarea
        id="cf-message"
        name="message"
        rows="5"
        placeholder="Tell us a bit about yourself or ask a question..."
        class={inputClass}
      ></textarea>
    </div>
    <button
      type="submit"
      class="w-full bg-accent text-white py-4 text-sm font-display tracking-widest uppercase hover:bg-red-800 transition-colors"
    >
      Send Message
    </button>
    <p class="text-xs text-white/35 text-center">
      Or call us at <a href="tel:+19052359119" class="text-white/60 hover:text-white">(905) 235-9119</a>
    </p>
  </form>
</div>
