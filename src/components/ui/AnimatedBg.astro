---
/**
 * Lake-surface wave background.
 * Four wave components propagating at different angles interfere to
 * produce an organic water-surface texture. Canvas paths are redrawn
 * every frame via rAF so the OS reduced-motion CSS block has no effect.
 */
interface Props {
  variant?: 'default' | 'hero' | 'subtle';
}
const { variant = 'default' } = Astro.props;

const OPACITY: Record<string, number> = {
  default: 0.055,
  hero:    0.085,
  subtle:  0.032,
};
---

<canvas
  class="topo-canvas"
  aria-hidden="true"
  data-opacity={OPACITY[variant ?? 'default']}
></canvas>

<style>
  .topo-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    user-select: none;
    z-index: 0;
    display: block;
  }
</style>

<script>
  function initWaves(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d')!;
    const opacity = parseFloat(canvas.dataset.opacity ?? '0.055');
    const dpr = Math.min(window.devicePixelRatio ?? 1, 2);

    let cssW = 0, cssH = 0;

    function resize() {
      cssW = canvas.offsetWidth  || (canvas.parentElement?.offsetWidth  ?? 1440);
      cssH = canvas.offsetHeight || (canvas.parentElement?.offsetHeight ?? 400);
      canvas.width  = cssW * dpr;
      canvas.height = cssH * dpr;
    }

    function draw(t: number) {
      if (cssW === 0) { resize(); return; }

      ctx.save();
      ctx.scale(dpr, dpr);
      ctx.clearRect(0, 0, cssW, cssH);
      ctx.lineWidth = 1;
      ctx.lineJoin  = 'round';
      ctx.strokeStyle = `rgba(255,255,255,${opacity})`;

      const SPACING = 22;
      const lineCount = Math.floor(cssH / SPACING) + 2;

      for (let i = 0; i < lineCount; i++) {
        const by = (i / Math.max(lineCount - 1, 1)) * cssH; // base y

        ctx.beginPath();
        let first = true;

        for (let x = 0; x <= cssW; x += 4) {
          // Four wave components, each propagating at a different angle.
          // kx/ky set the wavevector; positive ωt = leftward; negative = rightward.
          // Mixing angles and speeds creates natural interference patterns.
          const y = by
            // Long primary swell — slow, rightward, slight downward angle
            + 9   * Math.sin(x * 0.0060 + by * 0.0028 - t * 0.38)
            // Medium wave — leftward, slight upward angle
            + 5   * Math.sin(x * 0.0130 - by * 0.0050 + t * 0.54)
            // Short cross-ripple — rightward at steeper angle
            + 2.5 * Math.sin(x * 0.0240 + by * 0.0090 - t * 0.92)
            // Very long diagonal swell — leftward, strong cross-line component
            + 3.5 * Math.sin(x * 0.0028 + by * 0.0120 + t * 0.19);

          if (first) { ctx.moveTo(x, y); first = false; }
          else        ctx.lineTo(x, y);
        }

        ctx.stroke();
      }

      ctx.restore();
    }

    resize();
    window.addEventListener('resize', resize, { passive: true });

    function loop(ts: number) {
      if (cssW === 0) resize();
      draw(ts / 1000);
      requestAnimationFrame(loop);
    }
    requestAnimationFrame(loop);
  }

  document.querySelectorAll<HTMLCanvasElement>('.topo-canvas').forEach(initWaves);
</script>
