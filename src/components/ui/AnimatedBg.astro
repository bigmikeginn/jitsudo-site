---
// Flowing SVG wave animation. Use as a direct child of a relative-positioned section.
interface Props {
  variant?: 'default' | 'hero' | 'subtle';
}
const { variant = 'default' } = Astro.props;
---

<div class="animated-bg pointer-events-none select-none" aria-hidden="true" data-variant={variant}>
  <svg class="wave wave-1" viewBox="0 0 2880 200" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M0 100 C 240 40, 480 160, 720 100 S 1200 40, 1440 100 S 1920 160, 2160 100 S 2640 40, 2880 100" />
  </svg>
  <svg class="wave wave-2" viewBox="0 0 2880 200" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M0 110 C 200 30, 500 180, 720 110 S 1180 50, 1440 110 S 1940 180, 2160 110 S 2620 50, 2880 110" />
  </svg>
  <svg class="wave wave-3" viewBox="0 0 2880 200" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M0 90 C 280 60, 520 140, 720 90 S 1220 60, 1440 90 S 1960 140, 2160 90 S 2660 60, 2880 90" />
  </svg>
</div>

<style>
.animated-bg {
  position: absolute;
  inset: 0;
  overflow: hidden;
  z-index: 0;
}

/* Each SVG is 200% the parent width; translateX -50% loops one wavelength.
   viewBox 0–2880 covers the full path so nothing gets clipped. */
.wave {
  position: absolute;
  left: 0;
  width: 200%;
  height: 50%;
  fill: none;
  stroke-width: 1.5;
  /* Glow effect — soft halo around the stroke without extra lines */
  filter:
    drop-shadow(0 0 6px rgba(255, 255, 255, 0.35))
    drop-shadow(0 0 14px rgba(255, 255, 255, 0.20));
}

.wave-1 {
  top: 12%;
  stroke: rgba(255, 255, 255, 0.55);
  animation: flow-left 22s linear infinite;
}
.wave-2 {
  top: 38%;
  stroke: rgba(255, 255, 255, 0.40);
  stroke-width: 1.25;
  animation: flow-right 30s linear infinite;
}
.wave-3 {
  top: 64%;
  stroke: rgba(255, 255, 255, 0.30);
  stroke-width: 1;
  animation: flow-left 38s linear infinite;
  animation-delay: -8s;
}

/* Animations: full wavelength is 50% of SVG width because viewBox is 2x */
@keyframes flow-left {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
@keyframes flow-right {
  0%   { transform: translateX(-50%); }
  100% { transform: translateX(0); }
}

/* Hero variant — same waves, just brighter glow */
[data-variant="hero"] .wave-1 { stroke: rgba(255, 255, 255, 0.85); stroke-width: 2; }
[data-variant="hero"] .wave-2 { stroke: rgba(255, 255, 255, 0.65); stroke-width: 1.5; }
[data-variant="hero"] .wave-3 { stroke: rgba(255, 255, 255, 0.50); stroke-width: 1.25; }
[data-variant="hero"] .wave {
  filter:
    drop-shadow(0 0 8px rgba(255, 255, 255, 0.50))
    drop-shadow(0 0 18px rgba(255, 255, 255, 0.30));
}

/* Subtle variant — for sections sitting over a photo bg */
[data-variant="subtle"] .wave-1 { stroke: rgba(255, 255, 255, 0.30); }
[data-variant="subtle"] .wave-2 { stroke: rgba(255, 255, 255, 0.22); }
[data-variant="subtle"] .wave-3 { stroke: rgba(255, 255, 255, 0.18); }

/* Respect prefers-reduced-motion */
@media (prefers-reduced-motion: reduce) {
  .wave {
    animation: none !important;
  }
}
</style>
