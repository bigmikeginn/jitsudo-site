---
/**
 * Topographic contour-line background.
 * A dense field of smooth wave paths, very low opacity, continuously
 * scrolling left. The SVG is 200% wide so translateX(-50%) loops
 * seamlessly — wavelength 480 divides 1440 (container) exactly × 3.
 */
interface Props {
  variant?: 'default' | 'hero' | 'subtle';
}
const { variant = 'default' } = Astro.props;

const LINES  = 24;   // number of contour lines
const VW     = 2880; // viewBox width  (200% of 1440px container)
const VH     = 600;  // viewBox height (scales to fill section)
const WL     = 480;  // wavelength — must divide 1440 for seamless loop
const AMP    = 11;   // wave amplitude in viewBox units
const STEP   = WL / 4;   // quarter-wavelength sample spacing
const GOLDEN = 2.39996322; // 2π × golden-ratio fraction — natural phase spread

/** Catmull-Rom → cubic bezier conversion for smooth sine interpolation */
function wavePath(baseY: number, phase: number): string {
  const count = Math.ceil(VW / STEP) + 2;
  const pts = Array.from({ length: count }, (_, i) => ({
    x: i * STEP,
    y: +(baseY + AMP * Math.sin(phase + (i * Math.PI) / 2)).toFixed(2),
  }));

  let d = `M ${pts[0].x} ${pts[0].y}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[Math.max(0, i - 1)];
    const p1 = pts[i];
    const p2 = pts[i + 1];
    const p3 = pts[Math.min(pts.length - 1, i + 2)];
    const cp1x = +(p1.x + (p2.x - p0.x) / 6).toFixed(1);
    const cp1y = +(p1.y + (p2.y - p0.y) / 6).toFixed(2);
    const cp2x = +(p2.x - (p3.x - p1.x) / 6).toFixed(1);
    const cp2y = +(p2.y - (p3.y - p1.y) / 6).toFixed(2);
    d += ` C ${cp1x} ${cp1y},${cp2x} ${cp2y},${p2.x} ${p2.y}`;
  }
  return d;
}

const paths = Array.from({ length: LINES }, (_, i) => {
  const baseY = (i / (LINES - 1)) * VH;
  const phase = i * GOLDEN;
  return wavePath(baseY, phase);
});
---

<div class="topo-bg" aria-hidden="true" data-variant={variant}>
  <svg
    class="topo-svg"
    viewBox={`0 0 ${VW} ${VH}`}
    preserveAspectRatio="xMidYMid slice"
    xmlns="http://www.w3.org/2000/svg"
  >
    {paths.map((d) => <path d={d} />)}
  </svg>
</div>

<style>
  .topo-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
    user-select: none;
  }

  .topo-svg {
    position: absolute;
    left: 0;
    top: 0;
    width: 200%;
    height: 100%;
    will-change: transform;
  }

  .topo-svg path {
    fill: none;
    stroke: rgba(255, 255, 255, 0.055);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  [data-variant="hero"] .topo-svg path {
    stroke: rgba(255, 255, 255, 0.08);
  }

  [data-variant="subtle"] .topo-svg path {
    stroke: rgba(255, 255, 255, 0.035);
  }
</style>

<script>
  // Drive scroll via rAF so the OS "prefers-reduced-motion" CSS override can't kill it.
  // translateX(-50%) of a 200%-wide element = one full container width = one viewbox repeat.
  const DURATION = 32000; // ms for one full loop

  document.querySelectorAll<SVGSVGElement>('.topo-svg').forEach((svg) => {
    let progress = 0;
    let last: number | null = null;

    function tick(now: number) {
      if (last !== null) {
        progress += (now - last) / DURATION;
        if (progress >= 1) progress -= 1;
      }
      last = now;
      svg.style.transform = `translateX(-${(progress * 50).toFixed(4)}%)`;
      requestAnimationFrame(tick);
    }

    requestAnimationFrame(tick);
  });
</script>
