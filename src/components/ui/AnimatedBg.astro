---
// Flowing SVG wave animation. Use as a direct child of a relative-positioned section.
interface Props {
  variant?: 'default' | 'hero' | 'subtle';
}
const { variant = 'default' } = Astro.props;
---

<div class="animated-bg pointer-events-none select-none" aria-hidden="true" data-variant={variant}>
  <svg class="wave wave-1" viewBox="0 0 1440 200" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M0 100 C 240 40, 480 160, 720 100 S 1200 40, 1440 100 L 2880 100 C 2640 160, 2400 40, 2160 100 S 1680 160, 1440 100 Z" />
  </svg>
  <svg class="wave wave-2" viewBox="0 0 1440 200" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M0 110 C 200 30, 500 180, 720 100 S 1180 50, 1440 110 L 2880 110 C 2680 30, 2380 180, 2160 100 S 1700 50, 1440 110 Z" />
  </svg>
  <svg class="wave wave-3" viewBox="0 0 1440 200" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M0 90 C 280 60, 520 140, 720 100 S 1220 60, 1440 90 L 2880 90 C 2600 140, 2360 60, 2160 100 S 1660 140, 1440 90 Z" />
  </svg>
  <svg class="wave wave-4" viewBox="0 0 1440 200" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M0 80 C 360 130, 580 50, 720 95 S 1240 130, 1440 80 L 2880 80 C 2520 130, 2300 50, 2160 95 S 1640 130, 1440 80 Z" />
  </svg>
  <div class="glow glow-1"></div>
  <div class="glow glow-2"></div>
</div>

<style>
.animated-bg {
  position: absolute;
  inset: 0;
  overflow: hidden;
  z-index: 0;
}

/* Flowing wave layers — each wave is 2x viewBox width and slides left, looping seamlessly */
.wave {
  position: absolute;
  left: 0;
  width: 200%;
  height: 60%;
  fill: none;
  stroke-width: 1.5;
}

.wave-1 {
  top: 8%;
  stroke: var(--color-accent);
  opacity: 0.55;
  animation: flow-left 18s linear infinite;
}
.wave-2 {
  top: 30%;
  stroke: rgba(255, 255, 255, 0.45);
  opacity: 0.65;
  animation: flow-right 24s linear infinite;
}
.wave-3 {
  top: 52%;
  stroke: var(--color-accent);
  opacity: 0.40;
  animation: flow-left 30s linear infinite;
  animation-delay: -6s;
}
.wave-4 {
  top: 70%;
  stroke: rgba(255, 255, 255, 0.30);
  stroke-width: 1;
  opacity: 0.55;
  animation: flow-right 36s linear infinite;
}

/* Soft glows behind the waves for depth */
.glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(120px);
  pointer-events: none;
}
.glow-1 {
  width: 600px; height: 600px;
  top: -200px; left: -150px;
  background: var(--color-accent);
  opacity: 0.18;
  animation: glow-drift-1 22s ease-in-out infinite;
}
.glow-2 {
  width: 500px; height: 500px;
  bottom: -200px; right: -100px;
  background: var(--color-accent);
  opacity: 0.12;
  animation: glow-drift-2 28s ease-in-out infinite;
}

/* Animations: waves translate horizontally to flow */
@keyframes flow-left {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
@keyframes flow-right {
  0%   { transform: translateX(-50%); }
  100% { transform: translateX(0); }
}
@keyframes glow-drift-1 {
  0%, 100% { transform: translate(0, 0); }
  50%      { transform: translate(80px, 60px); }
}
@keyframes glow-drift-2 {
  0%, 100% { transform: translate(0, 0); }
  50%      { transform: translate(-60px, -40px); }
}

/* Hero variant — brighter and more saturated */
[data-variant="hero"] .wave-1 { opacity: 0.85; stroke-width: 2; }
[data-variant="hero"] .wave-2 { opacity: 0.85; stroke-width: 1.75; }
[data-variant="hero"] .wave-3 { opacity: 0.65; stroke-width: 1.75; }
[data-variant="hero"] .wave-4 { opacity: 0.75; stroke-width: 1.25; }
[data-variant="hero"] .glow-1 { opacity: 0.30; }
[data-variant="hero"] .glow-2 { opacity: 0.20; }

/* Subtle variant — for sections sitting over a photo bg */
[data-variant="subtle"] .wave-1 { opacity: 0.30; }
[data-variant="subtle"] .wave-2 { opacity: 0.30; }
[data-variant="subtle"] .wave-3 { opacity: 0.20; }
[data-variant="subtle"] .wave-4 { opacity: 0.25; }
[data-variant="subtle"] .glow-1 { opacity: 0.10; }
[data-variant="subtle"] .glow-2 { opacity: 0.08; }

/* Respect prefers-reduced-motion */
@media (prefers-reduced-motion: reduce) {
  .wave, .glow {
    animation: none !important;
  }
}
</style>
