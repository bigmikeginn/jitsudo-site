---
/**
 * Wave-art background.
 * Uses the waves.png artwork (white line-art on near-black).
 * mix-blend-mode: screen makes the dark background transparent so only
 * the white wave lines bleed through at low opacity.
 * A slow rAF-driven Lissajous drift (two slightly different sine periods)
 * keeps the image alive. The inner element is 130% × 130% so the edges
 * never expose during the drift.
 */
interface Props {
  variant?: 'default' | 'hero' | 'subtle';
}
const { variant = 'default' } = Astro.props;

const OPACITY: Record<string, number> = {
  default: 0.18,
  hero:    0.24,
  subtle:  0.10,
};
---

<div class="wave-bg" aria-hidden="true" style={`--op:${OPACITY[variant ?? 'default']}`}>
  <div class="wave-inner"></div>
</div>

<style>
  .wave-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
    user-select: none;
    opacity: var(--op, 0.18);
    mix-blend-mode: screen;
  }

  .wave-inner {
    position: absolute;
    top: -15%;
    left: -15%;
    width: 130%;
    height: 130%;
    background-image: url('/images/waves-bg.webp');
    background-size: cover;
    background-position: center;
    will-change: transform;
  }
</style>

<script>
  // Delay wave animations until the browser is idle so rAF loops don't
  // compete with LCP paint during the critical rendering window.
  function startWaves() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll<HTMLElement>('.wave-inner').forEach((el) => {
      const TX_AMP = 6, TY_AMP = 3, TX_T = 38, TY_T = 53;
      function loop(ts: number) {
        const t  = ts / 1000;
        const tx = TX_AMP * Math.sin((2 * Math.PI * t) / TX_T);
        const ty = TY_AMP * Math.sin((2 * Math.PI * t) / TY_T);
        el.style.transform = `translate(${tx.toFixed(3)}%, ${ty.toFixed(3)}%)`;
        requestAnimationFrame(loop);
      }
      requestAnimationFrame(loop);
    });
  }

  if ('requestIdleCallback' in window) {
    requestIdleCallback(startWaves, { timeout: 3000 });
  } else {
    setTimeout(startWaves, 2000);
  }
</script>
