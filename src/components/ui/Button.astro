---
interface Props {
  href?: string;
  variant?: 'primary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit';
  class?: string;
}

const { href, variant = 'primary', size = 'md', type = 'button', class: className = '' } = Astro.props;

const sizes: Record<string, string> = {
  sm: 'px-5 py-2.5 text-xs',
  md: 'px-8 py-4 text-sm',
  lg: 'px-10 py-5 text-base',
};
const variants: Record<string, string> = {
  primary: 'bg-accent text-white hover:bg-red-800',
  ghost: 'border border-white text-white hover:bg-white hover:text-black',
};
const classes = [
  'inline-block font-display tracking-widest uppercase transition-colors duration-200 cursor-pointer',
  sizes[size],
  variants[variant],
  className,
].join(' ');
---

{href ? (
  <a href={href} class={classes}><slot /></a>
) : (
  <button type={type} class={classes}><slot /></button>
)}
