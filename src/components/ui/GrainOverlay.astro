---
// Fixed: added missing Astro frontmatter fences
---
<div class="grain-overlay" aria-hidden="true">
  <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
    <filter id="grain-noise">
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.8"
        numOctaves="4"
        stitchTiles="stitch"
      />
    </filter>
    <rect width="100%" height="100%" filter="url(#grain-noise)"></rect>
  </svg>
</div>

<style>
  .grain-overlay {
    position: fixed;
    inset: 0;
    z-index: 50;
    pointer-events: none;
    opacity: 0.035;
  }
  .grain-overlay svg {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
