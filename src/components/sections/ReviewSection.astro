---
import Badge from '../ui/Badge.astro';
import ReviewCard from './ReviewCard.astro';

interface Review {
  name: string;
  text: string;
  rating?: number;
  date?: string;
  source?: 'google' | 'facebook';
}

interface Props {
  eyebrow?: string;
  heading?: string;
  featured?: Review;
  reviews: Review[];
}

const { eyebrow, heading, featured, reviews } = Astro.props;

const featuredInitials = featured
  ? featured.name.split(' ').map((n) => n[0]).slice(0, 2).join('')
  : '';
---

<section class="py-20 bg-black">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {eyebrow && <Badge label={eyebrow} class="mb-4 block" />}
    {heading && <h2 class="font-display text-4xl uppercase tracking-wide mb-12">{heading}</h2>}

    {featured && (
      <div class="mb-12 border-l-2 border-accent pl-8 py-2 max-w-3xl">
        <div class="flex items-center gap-4 mb-4">
          <div class="w-12 h-12 rounded-full bg-accent flex items-center justify-center shrink-0">
            <span class="font-display text-sm text-white">{featuredInitials}</span>
          </div>
          <div>
            <p class="font-display text-sm tracking-widest uppercase">{featured.name}</p>
            {featured.date && <p class="text-xs text-white/40 mt-0.5">{featured.date}</p>}
          </div>
        </div>
        <div class="flex gap-0.5 mb-4">
          {Array.from({ length: 5 }).map((_, i) => (
            <svg
              class={`w-4 h-4 ${i < (featured.rating ?? 5) ? 'text-accent' : 'text-white/20'}`}
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          ))}
        </div>
        <p class="text-lg text-white/80 leading-relaxed italic">
          <span class="text-accent text-2xl leading-none mr-1">&ldquo;</span>{featured.text}<span class="text-accent text-2xl leading-none ml-1">&rdquo;</span>
        </p>
      </div>
    )}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {reviews.map((review) => (
        <ReviewCard {...review} />
      ))}
    </div>
  </div>
</section>
