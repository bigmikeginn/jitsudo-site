---
// Fixed: removed redundant Google Fonts @import (JetBrains Mono loaded via @fontsource in Layout)
// Fixed: removed unused .border-white-10 class
---

<section class="credentials-strip" aria-label="Jitsu-Do at a glance">
  <div class="creds-container">
    <div class="stat-item border-mobile-v border-mobile-h border-desktop-v">
      <span class="value">30+</span>
      <span class="label">Years Teaching</span>
    </div>
    <div class="stat-item border-mobile-h border-desktop-v">
      <span class="value">Karate + BJJ</span>
      <span class="label">Disciplines</span>
    </div>
    <div class="stat-item border-mobile-v border-desktop-v">
      <span class="value">All Ages</span>
      <span class="label">Programs</span>
    </div>
    <div class="stat-item">
      <span class="value">Newmarket, ON</span>
      <span class="label">Location</span>
    </div>
  </div>
</section>

<style>
  .credentials-strip {
    background-color: #0a0a0a;
    width: 100%;
    padding: 1.5rem 0;
    color: #fff;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .creds-container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  @media (min-width: 768px) {
    .creds-container {
      display: flex;
      flex-direction: row;
      justify-content: space-around;
      padding: 0 2rem;
    }
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1.25rem 1rem;
    flex: 1;
  }

  .value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 2.2rem;
    font-weight: 700;
    color: #c8a96e;
    line-height: 1;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  @media (min-width: 1024px) {
    .value { font-size: 3rem; }
  }

  .label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.45);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-weight: 400;
  }

  @media (min-width: 768px) {
    .border-desktop-v {
      border-right: 1px solid rgba(255, 255, 255, 0.12);
    }
  }

  @media (max-width: 767px) {
    .border-mobile-v {
      border-right: 1px solid rgba(255, 255, 255, 0.12);
    }
    .border-mobile-h {
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }
  }
</style>
