---
import Badge from '../ui/Badge.astro';
import AnimatedBg from '../ui/AnimatedBg.astro';

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  items: FAQItem[];
}

const { eyebrow, heading, items } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);
---

<section class="relative py-20 bg-charcoal overflow-hidden">
  <AnimatedBg />
  <div class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="reveal">
      {eyebrow && <Badge label={eyebrow} class="mb-4 block" />}
      <h2 class="text-4xl font-semibold tracking-tight mb-12">{heading}</h2>
    </div>

    <div class="space-y-2 reveal" id={`faq-${uid}`}>
      {items.map((item, i) => (
        <div class="faq-row border-b border-white/10" data-faq-item>
          <button
            type="button"
            class="faq-btn group w-full flex items-center justify-between py-5 text-left gap-4"
            aria-expanded="false"
            data-faq-trigger
          >
            <span class="font-mono text-sm tracking-[0.18em] uppercase group-hover:text-white transition-colors duration-200">{item.question}</span>
            <span class="faq-icon-ring" aria-hidden="true">
              <svg
                class="w-4 h-4 text-accent transition-all duration-200 group-hover:text-white"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                data-faq-icon
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14"/>
              </svg>
            </span>
          </button>
          <div class="hidden pb-5 pr-8 text-sm text-white/65 leading-relaxed" data-faq-panel>
            {item.answer}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-row {
    transform-style: preserve-3d;
    will-change: transform;
  }

  .faq-icon-ring {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 1px solid transparent;
    flex-shrink: 0;
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  .faq-btn:hover .faq-icon-ring {
    border-color: rgba(200, 169, 110, 0.55);
    background: rgba(200, 169, 110, 0.1);
    transform: scale(1.2);
  }
</style>

<script>
  document.querySelectorAll('[data-faq-item]').forEach((item) => {
    const trigger = item.querySelector('[data-faq-trigger]') as HTMLButtonElement | null;
    const panel = item.querySelector('[data-faq-panel]') as HTMLElement | null;
    const icon = item.querySelector('[data-faq-icon]') as SVGElement | null;

    trigger?.addEventListener('click', () => {
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';
      trigger.setAttribute('aria-expanded', String(!isOpen));
      panel?.classList.toggle('hidden', isOpen);
      icon?.classList.toggle('rotate-45', !isOpen);
    });

    // Gentle 3D tilt on hover (softer than image cards)
    const MT = 3;
    let frameId: number | null = null;
    let px = 0, py = 0;

    const updateTilt = () => {
      const r = item.getBoundingClientRect();
      const rx = Math.max(-MT, Math.min(MT, -(py - r.top - r.height / 2) / (r.height / 2) * MT));
      const ry = Math.max(-MT, Math.min(MT, (px - r.left - r.width / 2) / (r.width / 2) * MT));
      (item as HTMLElement).style.transition = 'transform 0.08s ease-out';
      (item as HTMLElement).style.transform = `perspective(700px) rotateX(${rx}deg) rotateY(${ry}deg)`;
      frameId = null;
    };

    item.addEventListener('mousemove', (e) => {
      px = (e as MouseEvent).clientX;
      py = (e as MouseEvent).clientY;
      if (frameId === null) frameId = requestAnimationFrame(updateTilt);
    });

    item.addEventListener('mouseleave', () => {
      if (frameId !== null) { cancelAnimationFrame(frameId); frameId = null; }
      (item as HTMLElement).style.transition = 'transform 0.4s ease';
      (item as HTMLElement).style.transform = 'perspective(700px) rotateX(0deg) rotateY(0deg)';
    });
  });
</script>
