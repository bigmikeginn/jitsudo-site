---
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';
import AnimatedBg from '../ui/AnimatedBg.astro';

interface Props {
  eyebrow?: string;
  heading: string;
  body?: string;
  primaryCta: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  bgImage?: string;
  dark?: boolean;
}

const {
  eyebrow,
  heading,
  body,
  primaryCta,
  secondaryCta,
  bgImage,
  dark = true,
} = Astro.props;
---

<section
  class="relative py-24 px-4 text-center overflow-hidden"
  style={bgImage ? `background-image: url('${bgImage}'); background-size: cover; background-position: center;` : ''}
>
  {bgImage && (
    <div class={`absolute inset-0 ${dark ? 'bg-black/70' : 'bg-black/40'}`} aria-hidden="true"></div>
  )}
  {!bgImage && <div class="absolute inset-0 bg-surface" aria-hidden="true"></div>}
  {!bgImage && <AnimatedBg />}

  <div class="relative z-10 max-w-2xl mx-auto">
    {eyebrow && <Badge label={eyebrow} class="mb-4 block" />}
    <h2 class="font-display text-4xl sm:text-5xl uppercase tracking-wide mb-4">{heading}</h2>
    {body && <p class="text-white/70 mb-10 text-lg leading-relaxed">{body}</p>}
    <div class="flex flex-wrap items-center justify-center gap-4">
      <Button href={primaryCta.href} variant="primary" size="lg">{primaryCta.label}</Button>
      {secondaryCta && (
        <Button href={secondaryCta.href} variant="ghost" size="lg">{secondaryCta.label}</Button>
      )}
    </div>
  </div>
</section>
