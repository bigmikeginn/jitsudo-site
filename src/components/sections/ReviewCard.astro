---
interface Props {
  name: string;
  text: string;
  rating?: number;
  date?: string;
  source?: 'google' | 'facebook';
}

const { name, text, rating = 5, date, source = 'google' } = Astro.props;

const initials = name
  .split(' ')
  .map((n) => n[0])
  .slice(0, 2)
  .join('');
---

<div class="bg-surface-2 border border-white/8 p-6 flex flex-col gap-4">
  <div class="flex items-start justify-between gap-3">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-full bg-accent flex items-center justify-center shrink-0">
        <span class="font-display text-xs text-white">{initials}</span>
      </div>
      <div>
        <p class="font-mono text-xs tracking-widest uppercase">{name}</p>
        <div class="flex gap-0.5 mt-1" role="img" aria-label={`${rating} stars`}>
          {Array.from({ length: 5 }).map((_, i) => (
            <svg
              class={`w-3 h-3 ${i < rating ? 'text-accent' : 'text-white/20'}`}
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          ))}
        </div>
      </div>
    </div>
    {source === 'google' && (
      <svg class="w-5 h-5 text-white/25 shrink-0" viewBox="0 0 24 24" fill="currentColor">
        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
      </svg>
    )}
    {source === 'facebook' && (
      <svg class="w-5 h-5 text-white/25 shrink-0" fill="currentColor" viewBox="0 0 24 24">
        <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>
      </svg>
    )}
  </div>

  <p class="text-sm text-white/65 leading-relaxed italic">&ldquo;{text}&rdquo;</p>

  {date && <p class="text-xs text-white/35">{date}</p>}
</div>
