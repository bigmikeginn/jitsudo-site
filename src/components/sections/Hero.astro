---
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';
import AnimatedBg from '../ui/AnimatedBg.astro';

interface Props {
  eyebrow?: string;
  headline: string;
  accentLine?: string;
  body?: string;
  bullets?: string[];
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  bgImage?: string;
  minHeight?: string;
}

const {
  eyebrow,
  headline,
  accentLine,
  body,
  bullets = [],
  primaryCta,
  secondaryCta,
  bgImage,
  minHeight = 'min-h-screen',
} = Astro.props;
---

<section
  class={`relative flex items-end overflow-hidden ${minHeight}`}
  style={bgImage ? `background-image: url('${bgImage}'); background-size: cover; background-position: center top;` : ''}
>
  {bgImage && (
    <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/20 to-black/80" aria-hidden="true"></div>
  )}
  {!bgImage && <AnimatedBg variant="hero" />}

  <div class="relative z-10 w-full max-w-[1360px] mx-auto px-[clamp(20px,4vw,64px)] pb-[clamp(56px,9vh,112px)] pt-24">
    {eyebrow && (
      <div class="mb-6">
        <Badge label={eyebrow} />
      </div>
    )}

    <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl uppercase leading-[0.92] tracking-[-0.01em] max-w-[16ch] mb-0">
      {headline}
    </h1>

    {accentLine && (
      <p class="font-display text-5xl sm:text-6xl lg:text-7xl uppercase leading-[0.92] tracking-[-0.01em] text-accent mb-6">
        {accentLine}
      </p>
    )}

    {body && (
      <p class="text-lg text-white/70 max-w-[52ch] mt-6 mb-8 leading-relaxed">
        {body}
      </p>
    )}

    {bullets.length > 0 && (
      <p class="text-sm text-white/50 mb-8 font-mono tracking-[0.1em]">
        {bullets.map((b, i) => (
          <span>
            <span class="text-accent">✓</span> {b}
            {i < bullets.length - 1 ? ' · ' : ''}
          </span>
        ))}
      </p>
    )}

    {(primaryCta || secondaryCta) && (
      <div class="flex flex-wrap items-center gap-4">
        {primaryCta && <Button href={primaryCta.href} variant="primary">{primaryCta.label}</Button>}
        {secondaryCta && <Button href={secondaryCta.href} variant="ghost">{secondaryCta.label}</Button>}
      </div>
    )}
  </div>
</section>
