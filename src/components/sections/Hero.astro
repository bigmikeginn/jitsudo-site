---
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';
import AnimatedBg from '../ui/AnimatedBg.astro';

interface Props {
  eyebrow?: string;
  headline: string;
  accentLine?: string;
  body?: string;
  bullets?: string[];
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  bgImage?: string;
  bgImagePosition?: string;
  minHeight?: string;
}

const {
  eyebrow,
  headline,
  accentLine,
  body,
  bullets = [],
  primaryCta,
  secondaryCta,
  bgImage,
  bgImagePosition,
  minHeight = 'min-h-screen',
} = Astro.props;
---

<section
  class={`hero-section relative flex items-end overflow-hidden ${minHeight}`}
>
  {bgImage && (
    <>
      <img
        src={bgImage}
        alt=""
        aria-hidden="true"
        fetchpriority="high"
        loading="eager"
        decoding="async"
        class="hero-bg-img absolute inset-0 w-full h-full object-cover"
        style={bgImagePosition ? `object-position: ${bgImagePosition}` : undefined}
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/20 to-black/80" aria-hidden="true"></div>
    </>
  )}
  {!bgImage && <AnimatedBg variant="hero" />}

  <!-- Warm red radial glow — sits behind content, gives depth without aggression -->
  <div
    class="absolute inset-0 pointer-events-none"
    aria-hidden="true"
    style="background: radial-gradient(ellipse 55% 50% at 18% 72%, rgba(196,30,30,0.16) 0%, transparent 65%);"
  ></div>

  <div class="relative z-10 w-full max-w-[1360px] mx-auto px-[clamp(20px,4vw,64px)] pb-[clamp(56px,9vh,112px)] pt-24">
    {eyebrow && (
      <div class="mb-6">
        <Badge label={eyebrow} />
      </div>
    )}

    <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl uppercase leading-[0.92] tracking-[-0.01em] max-w-[16ch] mb-0">
      {headline}
    </h1>

    {accentLine && (
      <p class="font-display text-5xl sm:text-6xl lg:text-7xl uppercase leading-[0.92] tracking-[-0.01em] text-accent mb-6">
        {accentLine}
      </p>
    )}

    {body && (
      <div class="hero-body mt-6 mb-8">
        <p class="text-lg text-white/90 max-w-[52ch] leading-relaxed">
          {body}
        </p>
      </div>
    )}

    {bullets.length > 0 && (
      <p class="text-sm text-white/50 mb-8 font-mono tracking-[0.1em]">
        {bullets.map((b, i) => (
          <span>
            <span class="text-accent">✓</span> {b}
            {i < bullets.length - 1 ? ' · ' : ''}
          </span>
        ))}
      </p>
    )}

    {(primaryCta || secondaryCta) && (
      <div class="flex flex-wrap items-center gap-4">
        {primaryCta && <Button href={primaryCta.href} variant="primary">{primaryCta.label}</Button>}
        {secondaryCta && <Button href={secondaryCta.href} variant="ghost">{secondaryCta.label}</Button>}
      </div>
    )}
  </div>
</section>

<style>
  .hero-bg-img {
    object-position: left top;
  }

  @media (min-width: 768px) {
    .hero-bg-img {
      object-position: center top;
    }
  }

  .hero-body {
    border-left: 2px solid rgba(200, 169, 110, 0.65);
    padding-left: 1.25rem;
    background: linear-gradient(90deg, rgba(200,169,110,0.06) 0%, transparent 70%);
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
  }
</style>
