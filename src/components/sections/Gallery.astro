---
import AnimatedBg from '../ui/AnimatedBg.astro';

interface GalleryImage {
  src: string;
  alt: string;
}

interface Props {
  images: GalleryImage[];
  eyebrow?: string;
  heading?: string;
}

const { images, eyebrow, heading } = Astro.props;
---

<section class="relative py-12 bg-charcoal overflow-hidden">
  {(eyebrow || heading) && (
    <AnimatedBg />
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-8 reveal">
      {eyebrow && <p class="text-xs tracking-[0.25em] uppercase text-white/40 mb-3">{eyebrow}</p>}
      {heading && <h2 class="text-4xl font-semibold tracking-tight">{heading}</h2>}
    </div>
  )}

  <div class="gc-outer reveal" role="region" aria-label={heading ?? 'Gallery'}>
    <div class="gc-stage" aria-live="polite">
      {images.map((img, i) => (
        <div class="gc-slide" data-slot="2" aria-hidden={i !== 0 ? 'true' : undefined}>
          <img
            src={img.src}
            alt={img.alt}
            loading={i === 0 ? 'eager' : 'lazy'}
            width="600"
            height="400"
            draggable="false"
          />
        </div>
      ))}
    </div>
    <!-- edge vignettes -->
    <div class="gc-vignette gc-vignette-left" aria-hidden="true"></div>
    <div class="gc-vignette gc-vignette-right" aria-hidden="true"></div>
  </div>
</section>

<script>
  function initFlow(outer: HTMLElement) {
    const stage = outer.querySelector<HTMLElement>('.gc-stage')!;
    const slides = Array.from(stage.querySelectorAll<HTMLElement>('.gc-slide'));
    const total = slides.length;
    let center = 0;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // slot configs: [scale, opacity, grayscale%, z-index]
    const CONFIGS: Record<number, [number, number, number, number]> = {
      0: [1.00, 1.00,  0, 5],
      1: [0.82, 0.62, 25, 4],
      2: [0.66, 0.32, 65, 3],
    };
    const FALLOFF = [0.52, 0.18, 80, 2]; // |slot| >= 3

    function getSlot(i: number): number {
      const raw = ((i - center) % total + total) % total;
      return raw <= Math.floor(total / 2) ? raw : raw - total;
    }

    function layout() {
      const stageW = stage.offsetWidth;
      const slideW = slides[0].offsetWidth;
      const step = slideW + 14;
      const cx = (stageW - slideW) / 2;

      slides.forEach((slide, i) => {
        const slot = getSlot(i);
        const absSlot = Math.min(Math.abs(slot), 3);
        const [scale, opacity, gray, z] = CONFIGS[absSlot] ?? FALLOFF;
        const x = cx + slot * step;

        slide.style.transform = `translateX(${x}px) scale(${scale})`;
        slide.style.opacity = String(opacity);
        slide.style.zIndex = String(z);
        slide.style.filter = gray > 0 ? `grayscale(${gray}%)` : '';
        slide.dataset.slot = String(absSlot);
        slide.setAttribute('aria-hidden', slot === 0 ? 'false' : 'true');
      });
    }

    function advance() {
      center = (center + 1) % total;
      layout();
    }

    layout();
    window.addEventListener('resize', layout, { passive: true });

    if (!reduced && total > 1) {
      setInterval(advance, 2500);
    }
  }

  document.querySelectorAll<HTMLElement>('.gc-outer').forEach(initFlow);
</script>

<style>
  .gc-outer {
    position: relative;
    height: 200px;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .gc-outer { height: 230px; }
  }

  .gc-stage {
    position: absolute;
    inset: 0;
  }

  .gc-slide {
    position: absolute;
    top: 0;
    left: 0;
    /* width set by JS offset — CSS just defines the size */
    width: clamp(160px, 48vw, 270px);
    height: 100%;
    overflow: hidden;
    transition:
      transform 0.7s cubic-bezier(0.4, 0, 0.2, 1),
      opacity   0.7s ease,
      filter    0.7s ease;
    will-change: transform, opacity;
  }

  @media (prefers-reduced-motion: reduce) {
    .gc-slide { transition: none; }
  }

  .gc-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
    user-select: none;
  }

  /* edge fade-out to match section bg */
  .gc-vignette {
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(60px, 12vw, 140px);
    z-index: 10;
    pointer-events: none;
  }
  .gc-vignette-left  {
    left: 0;
    background: linear-gradient(to right, #1a1a1a 0%, transparent 100%);
  }
  .gc-vignette-right {
    right: 0;
    background: linear-gradient(to left, #1a1a1a 0%, transparent 100%);
  }
</style>
