---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import Badge from '../components/ui/Badge.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import CTABand from '../components/sections/CTABand.astro';
import AnimatedBg from '../components/ui/AnimatedBg.astro';
import { business } from '../data/business';
---
<Layout
  title="Contact — Jitsu-Do Karate Newmarket"
  description="Contact Jitsu-Do Karate at 1211 Gorham Street, Unit 5, Newmarket. Call (905) 235-9119 or send a message online."
>
  <Hero
    eyebrow="Newmarket, Ontario"
    headline="Contact Us"
    body="Questions about programs, pricing, or your first class? We reply within one business day."
    primaryCta={{ label: 'Book Free Trial', href: '/trial' }}
    secondaryCta={{ label: `Call ${business.phoneDisplay}`, href: `tel:${business.phone}` }}
    bgImage="/images/jitsu-do-belt.webp"
    bgImagePosition="75% top"
    minHeight="min-h-[55vh]"
  />

  <section class="relative py-20 bg-charcoal overflow-hidden">
    <AnimatedBg />
    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12">
      <div>
        <Badge label="Find Us" class="mb-4 block" />
        <h2 class="text-3xl font-semibold tracking-tight mb-8">Location & Hours</h2>

        <div class="space-y-6 text-white/80">
          <div>
            <p class="font-mono text-xs tracking-[0.2em] uppercase text-white/50 mb-2">Address</p>
            <p class="mb-2">{business.address.street}<br />{business.address.city}, {business.address.region} {business.address.postalCode}</p>
            <a
              href="https://www.google.com/maps/search/?api=1&query=1211+Gorham+Street+Unit+5+Newmarket+Ontario"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs text-accent hover:text-white transition-colors"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              Get Directions
            </a>

            <!-- Map embed -->
            <div class="mt-6 overflow-hidden border border-white/10" style="aspect-ratio: 16/9;">
              <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2872.6!2d-79.4600!3d44.0510!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x882ad05f15b17a2f%3A0x71bcd40e29d3e8ee!2s1211%20Gorham%20St%20%235%2C%20Newmarket%2C%20ON%20L3Y%208Y3!5e0!3m2!1sen!2sca!4v1714900000000!5m2!1sen!2sca"
                width="100%"
                height="100%"
                style="border:0; filter: invert(90%) hue-rotate(180deg) saturate(0.8);"
                allowfullscreen
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="Jitsu-Do Karate location map"
              ></iframe>
            </div>
          </div>
          <div>
            <p class="font-mono text-xs tracking-[0.2em] uppercase text-white/50 mb-2">Hours</p>
            <p>Monday – Friday: 5:00 – 8:15 pm<br />Saturday: 8:30 – 11:30 am</p>
          </div>
          <div>
            <p class="font-mono text-xs tracking-[0.2em] uppercase text-white/50 mb-2">Phone</p>
            <a href={`tel:${business.phone}`} class="text-accent hover:text-white transition-colors">{business.phoneDisplay}</a>
          </div>
          <div>
            <p class="font-mono text-xs tracking-[0.2em] uppercase text-white/50 mb-2">Email</p>
            <a href={`mailto:${business.email}`} class="text-accent hover:text-white transition-colors">{business.email}</a>
          </div>
        </div>
      </div>

      <div>
        <Badge label="Send a Message" class="mb-4 block" />
        <h2 class="text-3xl font-semibold tracking-tight mb-8">Reply Within<br />One Business Day</h2>
        <ContactForm />
      </div>
    </div>
  </section>

  <CTABand
    eyebrow="New students"
    heading="Not sure where to start?"
    body="Your first class is free. No gear, no contracts — just come in and train."
    primaryCta={{ label: 'Book Free Trial', href: '/trial' }}
  />
</Layout>
