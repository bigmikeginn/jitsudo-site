---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import Badge from '../components/ui/Badge.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import CTABand from '../components/sections/CTABand.astro';
import { business } from '../data/business';
---
<Layout
  title="Contact — Jitsu-Do Karate Newmarket"
  description="Contact Jitsu-Do Karate at 1211 Gorham Street, Unit 5, Newmarket. Call (905) 235-9119 or send a message online."
>
  <Hero
    eyebrow="Newmarket, Ontario"
    headline="Contact Us"
    body="Questions about programs, pricing, or your first class? We reply within one business day."
    primaryCta={{ label: 'Book Free Trial', href: '/trial' }}
    secondaryCta={{ label: `Call ${business.phoneDisplay}`, href: `tel:${business.phone}` }}
    minHeight="min-h-[55vh]"
  />

  <section class="py-20 bg-black">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12">
      <div>
        <Badge label="Find Us" class="mb-4 block" />
        <h2 class="font-display text-3xl uppercase tracking-wide mb-8">Location & Hours</h2>

        <div class="space-y-6 text-white/80">
          <div>
            <p class="font-display text-xs tracking-[0.2em] uppercase text-white/50 mb-2">Address</p>
            <p>{business.address.street}<br />{business.address.city}, {business.address.region} {business.address.postalCode}</p>
          </div>
          <div>
            <p class="font-display text-xs tracking-[0.2em] uppercase text-white/50 mb-2">Hours</p>
            <p>Monday – Friday: 5:00 – 8:15 pm<br />Saturday: 8:30 – 11:30 am</p>
          </div>
          <div>
            <p class="font-display text-xs tracking-[0.2em] uppercase text-white/50 mb-2">Phone</p>
            <a href={`tel:${business.phone}`} class="text-accent hover:text-white transition-colors">{business.phoneDisplay}</a>
          </div>
          <div>
            <p class="font-display text-xs tracking-[0.2em] uppercase text-white/50 mb-2">Email</p>
            <a href={`mailto:${business.email}`} class="text-accent hover:text-white transition-colors">{business.email}</a>
          </div>
        </div>
      </div>

      <div>
        <Badge label="Send a Message" class="mb-4 block" />
        <h2 class="font-display text-3xl uppercase tracking-wide mb-8">Reply Within<br />One Business Day</h2>
        <ContactForm />
      </div>
    </div>
  </section>

  <CTABand
    eyebrow="New students"
    heading="Not sure where to start?"
    body="Your first class is free. No gear, no contracts — just come in and train."
    primaryCta={{ label: 'Book Free Trial', href: '/trial' }}
  />
</Layout>
