---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import Badge from '../components/ui/Badge.astro';
import CTABand from '../components/sections/CTABand.astro';
import AnimatedBg from '../components/ui/AnimatedBg.astro';
import FAQAccordion from '../components/sections/FAQAccordion.astro';
import { startingPriceLabel } from '../data/pricing';

const parentFaq = [
  {
    question: 'What ages and class format is this?',
    answer: 'Kids Foundations runs for ages 6–12, grouped by age and belt level, in 45-minute classes 1–2x per week. Kickstart (ages 4–6) runs as an 8-week session at a slower pace built for younger learners. Class sizes stay small enough that every student is corrected individually, not just drilled in unison.',
  },
  {
    question: 'What does a first class look like?',
    answer: 'Your child checks in with an instructor for a short one-on-one orientation, then joins the group for warm-up, basic technique drilling, and a cool-down bow-out. A senior student or assistant instructor stays close to new students the entire class. No sparring or contact drills happen in a first class.',
  },
  {
    question: 'What should they wear and bring?',
    answer: 'Comfortable athletic clothing is fine for a trial class — no gi required. Bare feet on the mat (no shoes), hair tied back if long, and a water bottle. Once enrolled, a proper gi is required and available for purchase through our store.',
  },
  {
    question: 'What is the typical progression and goals?',
    answer: 'Students test for stripes and belts on a regular grading cycle as they demonstrate new material — never on a fixed timeline. Kickstart graduates move into Kids Foundations white belt already familiar with dojo protocol. Every child progresses at their own pace, with stripes and belt promotions earned as skills are demonstrated.',
  },
  {
    question: 'How is safety and supervision handled?',
    answer: 'All partner drills are supervised directly by Shihan Ginn or a senior instructor, matched by size and experience level — never left to figure out on their own. Mats cover the full training floor, and contact is introduced gradually and always under direct supervision as a student\'s control and technique develop.',
  },
  {
    question: 'Can parents watch class?',
    answer: 'Yes — there\'s seating for parents to watch every class, and you\'re welcome to stay. Many parents drop off and run errands nearby; either way works.',
  },
];

const pillars = [
  {
    title: 'The Dojo Standard',
    body: 'Discipline is not punishment — it is protocol. Students learn the bow-in culture and the importance of listening and following technical instruction from day one.',
  },
  {
    title: 'Safe Boundaries',
    body: 'We focus on gross motor development and body awareness. Learning the structural basics of Jitsu-Do Karate develops balance and physical confidence that carries into every other sport.',
  },
  {
    title: 'A Lifelong Foundation',
    body: 'The best time to build a scaffold for a disciplined life is during the formative years. The habits built here carry forward into academics, sport, and character.',
  },
];

const benefits = [
  'Focus and listening skills that carry into the classroom',
  'Body awareness, balance, and coordination',
  'Respect for protocol — bow-in, listen, execute',
  'Confidence built from real physical capability',
  'Friendships in a high-standard, kind environment',
];

const kickstartDetails = [
  'Same curriculum as our 6-year-old white belt program',
  'Proper uniform required from day one — gi and belt available through our store',
  'Stripe progression on their belt as they advance',
  'Pacing, drills, and instruction calibrated for younger learners',
];
---
<Layout
  title="Kids Karate & BJJ — Jitsu-Do Newmarket"
  description="Kids karate and jiu-jitsu classes in Newmarket for ages 6–12. Foundational discipline, focus, and respect. Free trial class available."
>
  <Hero
    eyebrow="Ages 6–12 · Newmarket"
    headline="Kids Karate"
    accentLine="& Jiu-Jitsu"
    body="A martial arts journey built on technical excellence — not just high-energy play. Foundations of Karate and Jiu-Jitsu in a structured, high-standard environment."
    primaryCta={{ label: 'Book Free Trial', href: '/trial' }}
    secondaryCta={{ label: 'View Schedule', href: '/schedule' }}
    bgImage="/images/bow-in-2.webp"
    minHeight="min-h-[70vh]"
  />

  <section class="relative py-20 bg-charcoal overflow-hidden">
    <AnimatedBg />
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <Badge label="Why Jitsu-Do for Kids" class="mb-4 block" />
      <h2 class="text-4xl font-semibold tracking-tight mb-8">More Than Just Kicks</h2>
      <p class="text-white/75 leading-relaxed mb-6">
        At Jitsu-Do, we believe a child's martial arts journey should be built on a foundation of <strong class="text-white">technical excellence</strong>, not just high-energy play. Our Kids Foundations program introduces the fundamental biomechanics of Karate and Jiu-Jitsu in a structured, high-standard environment.
      </p>
      <p class="text-white/75 leading-relaxed">
        We don't just teach kids how to kick — we teach them how to focus, how to respect the process, and how to build genuine physical capability.
      </p>
    </div>
  </section>

  <section class="relative py-20 bg-surface overflow-hidden">
    <AnimatedBg />
    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {pillars.map((p) => (
          <div class="border-l-2 border-accent pl-6">
            <h3 class="text-xl font-semibold tracking-tight mb-4">{p.title}</h3>
            <p class="text-white/65 leading-relaxed text-sm">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="relative py-20 bg-photo-parallax overflow-hidden">
    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <Badge label="What They'll Build" class="mb-4 block" />
        <h3 class="text-3xl font-semibold tracking-tight mb-6">Skills For Life</h3>
        <ul class="space-y-3 mb-8" data-stagger-list>
          {benefits.map((b) => (
            <li class="flex gap-3 text-white/80">
              <span class="text-accent shrink-0">✓</span>
              <span>{b}</span>
            </li>
          ))}
        </ul>
        <div class="border-l-2 border-accent/50 pl-5 mb-6">
          <p class="font-mono text-xs tracking-[0.2em] uppercase text-accent/70 mb-2">Right Fit</p>
          <p class="text-white/70 leading-relaxed text-sm">
            Children aged <strong class="text-white">6–12</strong> of any experience level. High-energy kids, those who need focus and structure, and complete beginners all thrive.
          </p>
        </div>
        <p class="text-white/50 text-sm">Memberships from <a href="/schedule" class="text-accent hover:text-white transition-colors">{startingPriceLabel}</a>.</p>
      </div>
      <div class="aspect-[4/3] overflow-hidden">
        <img
          src="/images/3x-seiza-hzWGsz3r226OhdrB.jpg"
          alt="Kids training at Jitsu-Do Newmarket"
          class="w-full h-full object-cover grayscale saturate-50"
          loading="lazy"
          width="800"
          height="600"
        />
      </div>
    </div>
  </section>

  <section class="relative py-20 bg-charcoal overflow-hidden">
    <AnimatedBg />
    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <Badge label="Ages 4–6 · Karate" class="mb-4 block" />
        <h2 class="text-4xl font-semibold tracking-tight mb-4">Kickstart</h2>
        <p class="text-white/75 leading-relaxed mb-6">
          Kickstart is our 8-week introductory karate program designed specifically for children aged 4–6. Students wear a proper uniform, train the same core material as a 6-year-old white belt, and earn stripes on their belt as they progress — all delivered at a pace built for younger learners.
        </p>
        <ul class="space-y-3 mb-8">
          {kickstartDetails.map((d) => (
            <li class="flex gap-3 text-white/80">
              <span class="text-accent shrink-0">✓</span>
              <span>{d}</span>
            </li>
          ))}
        </ul>
        <div class="border-l-2 border-accent/50 pl-5">
          <p class="font-mono text-xs tracking-[0.2em] uppercase text-accent/70 mb-2">Program Details</p>
          <p class="text-white/70 leading-relaxed text-sm">
            8-week session &middot; <strong class="text-white">$140</strong> per session
          </p>
        </div>
      </div>
      <div class="flex flex-col gap-6">
        <div class="border-l-2 border-accent pl-6">
          <h3 class="text-lg font-semibold tracking-tight mb-2">Real Martial Arts, Right-Sized</h3>
          <p class="text-white/65 leading-relaxed text-sm">This isn't a watered-down playgroup. Kickstart teaches the same foundational karate material your child will continue in Kids Foundations — just with instruction calibrated for the 4–6 age group.</p>
        </div>
        <div class="border-l-2 border-accent pl-6">
          <h3 class="text-lg font-semibold tracking-tight mb-2">Uniform &amp; Belt from Day One</h3>
          <p class="text-white/65 leading-relaxed text-sm">Students train in a proper gi, purchased through our store, and earn stripes on their belt as they demonstrate new skills. Structure and ceremony matter — even for the youngest students.</p>
        </div>
        <div class="border-l-2 border-accent pl-6">
          <h3 class="text-lg font-semibold tracking-tight mb-2">The Perfect Bridge</h3>
          <p class="text-white/65 leading-relaxed text-sm">Kickstart graduates move naturally into Kids Foundations at age 6, already familiar with dojo protocol, basic technique, and what it means to be a Jitsu-Do student.</p>
        </div>
      </div>
    </div>
  </section>

  <FAQAccordion
    eyebrow="For Parents"
    heading="What to Expect"
    items={parentFaq}
  />

  <CTABand
    eyebrow="Start the foundation"
    heading="Claim Your Free Trial"
    body="No commitment, no pressure. Athletic clothing is fine — come see if Jitsu-Do is the right fit for your child."
    primaryCta={{ label: 'Book Free Trial', href: '/trial' }}
    secondaryCta={{ label: 'See Schedule', href: '/schedule' }}
  />
</Layout>
