---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import Badge from '../components/ui/Badge.astro';
import ClassCard from '../components/sections/ClassCard.astro';
import FAQAccordion from '../components/sections/FAQAccordion.astro';
import ReviewSection from '../components/sections/ReviewSection.astro';
import Gallery from '../components/sections/Gallery.astro';
import CTABand from '../components/sections/CTABand.astro';
import Button from '../components/ui/Button.astro';
import AnimatedBg from '../components/ui/AnimatedBg.astro';
import CredentialsStrip from '../components/sections/CredentialsStrip.astro';
import PhilosophyStatement from '../components/sections/PhilosophyStatement.astro';
import KanjiDecor from '../components/ui/KanjiDecor.astro';
import { business } from '../data/business';

const faqItems = [
  {
    question: 'How long does a trial class take?',
    answer: 'A trial class takes 30–45 minutes. You wear your own clothes and train alongside beginners. Senior students are always present to support you — you\'re never on your own.',
  },
  {
    question: 'Am I too old? Do I need to be fit?',
    answer: 'You\'re never too old. Anyone can do this and all students are encouraged to go at their own pace. We\'re about personal progress — not competing to see who\'s fastest or strongest.',
  },
  {
    question: 'What do I need to bring?',
    answer: 'Just yourself and comfortable clothes. No gi, no equipment, no experience required for your first visit. We\'ll guide you through everything.',
  },
  {
    question: 'Is there a sign-up fee or contract?',
    answer: 'No commitment required for your free trial. If you decide to join, we offer flexible membership options — no long-term contracts forcing you to stay.',
  },
];

const featuredReview = {
  name: 'Heather West',
  text: 'Jitsu-Do is like no other dojo I\'ve encountered — high quality teaching, every student known by name. We train hard and laugh a lot. Sensei Ginn explains the why behind everything, welcomes every question, and has a witty sense of humour. You\'d be lucky to train here.',
  rating: 5,
  date: 'Member 13 years',
  source: 'google' as const,
};

const reviews = [
  { name: 'Lia Carpino', text: 'We are so happy with Jitsu-Do Karate! Our son has had a wonderful experience and greatly enjoys the classes!', rating: 5, date: '17 weeks ago', source: 'google' as const },
  { name: 'Min Kim', text: 'Our child truly enjoyed this class — he\'d come home proudly practicing what he learned. A great balance of learning and play.', rating: 5, date: '18 weeks ago', source: 'google' as const },
  { name: 'Scott Morris', text: 'Sensei Mike not only showed you how to do techniques but why — always practical, always engaging. Thank you for the fun!', rating: 5, date: 'Mar 14, 2025', source: 'google' as const },
  { name: 'Scott Matthews', text: 'Great place. We have been bringing our oldest son for almost 7 years. Sensei Mike is a great teacher who is very patient and professional. He is passionate about teaching his students what they need to learn, and is friendly and easy to communicate with. You won\'t regret coming here. I\'d give Jitsu-Do 10 stars.', rating: 5, date: 'May 19, 2023', source: 'google' as const },
  { name: 'Susanne Prestwich', text: 'Our children have been with Jitsu-Do for years. The training that they receive is thorough, and more about lifestyle and discipline than it is about how fast you can progress. They have seen how their hard work is directly linked to their achievement. It is a very family-friendly dojo, with a Sensei who is interested in the development of his students as well-rounded people.', rating: 5, date: 'Apr 2, 2023', source: 'google' as const },
  { name: 'mikekitsune123 S', text: 'A great place to learn martial arts. Sensei Mike Ginn has many decades of training and teaching with a very extensive background at teaching people of all abilities. His assistant black belts are a wonderful addition at supporting students\' success. The facility is very clean and well lit with a very welcoming atmosphere. You won\'t be disappointed.', rating: 5, date: 'Apr 1, 2023', source: 'google' as const },
  { name: 'Jeanette Puna', text: 'My daughter attended Jitsu-Do for many years, and has many fond memories of her time there. We saw her personal growth in confidence and athleticism from the training she received from Sensei Ginn. He has a keen eye for his students\' strengths and weaknesses and personalizes training accordingly. Keep up the great work Sensei!', rating: 5, date: 'Mar 29, 2023', source: 'google' as const },
  { name: 'Dennis Dizon', text: 'My son joined over a year ago and has shown more interest in karate than any other sport. Sensei Ginn explains advanced concepts in an informative manner while keeping the class fun for all ages.', rating: 5, source: 'facebook' as const },
  { name: 'Mumsietwo Rosen', text: 'Our son has been coming here over a year and absolutely loves it. Sensei is always friendly and welcoming. He teaches kids so well.', rating: 5, source: 'facebook' as const },
  { name: 'Cassandra Matejka', text: 'My son and I love this place. Fun and challenging for both of us, everyone is welcoming. Sensei explains the reasoning behind every technique.', rating: 5, source: 'facebook' as const },
  { name: 'Barb Karadimos Billinger', text: 'Sensei Ginn is one of the best teachers I\'ve seen in action. The lessons are fun but also full of learning, and his teaching technique imparts an excellent balance of fun, knowledge and discipline to an age bracket that can be difficult to teach. My son loves his lessons with Sensei. Highly recommended.', rating: 5, date: 'Dec 4, 2015', source: 'facebook' as const },
];

const galleryImages = [
  { src: '/images/intermediate-class-shuto-zvNTZVpOSlKKzbMX.jpg', alt: 'Karate intermediate class at Jitsu-Do' },
  { src: '/images/brothers-smiling.jpg', alt: 'Two young students smiling in gi at Jitsu-Do' },
  { src: '/images/cameron-throwing-sensei-c24NNNY01tl3OwG8.jpg', alt: 'Karate throw at Jitsu-Do' },
  { src: '/images/sensei-teaching-luke.jpg', alt: 'Sensei Ginn teaching students at Jitsu-Do' },
  { src: '/images/harrison-hip-toss-eOo9x8cW5NLwYzAL.jpg', alt: 'BJJ hip toss' },
  { src: '/images/harry-kick-bw.jpg', alt: 'Student delivering a kick at Jitsu-Do' },
  { src: '/images/fuji-bjj-b-w-vguZNDdu5JCYl6qM.jpg', alt: 'BJJ grappling at Jitsu-Do' },
  { src: '/images/charlotte-smile.jpg', alt: 'Student smiling on the mat at Jitsu-Do' },
  { src: '/images/charlotte-roundhouse-QFzAmO1THZeA6cRQ.jpg', alt: 'Roundhouse kick at Jitsu-Do' },
  { src: '/images/ethan-hiza-kosa-2.jpg', alt: 'Ethan van Kessel in hiza kosa at Jitsu-Do' },
  { src: '/images/iris-side-kick.jpg', alt: 'Iris delivering a side kick at Jitsu-Do' },
  { src: '/images/roundhouse.jpg', alt: 'Roundhouse kick at Jitsu-Do' },
  { src: '/images/ashi-barai-2.jpg', alt: 'Ashi barai sweep at Jitsu-Do' },
  { src: '/images/punch-line-2.jpg', alt: 'Students punching in line at Jitsu-Do' },
  { src: '/images/sensei-and-liam.jpg', alt: 'Sensei Ginn with Liam at Jitsu-Do' },
  { src: '/images/sensei-kick-2.jpg', alt: 'Sensei Ginn demonstrating a kick at Jitsu-Do' },
  { src: '/images/sensei-lucien-bag-2.jpg', alt: 'Sensei Ginn and Lucien on the bag at Jitsu-Do' },
];
---
<Layout
  title={`${business.name} — Newmarket Karate + BJJ`}
  description="Jitsu-Do Karate Newmarket: High-standard martial arts training in practical karate and Brazilian Jiu-Jitsu. No fluff, real results."
>
  <Hero
    eyebrow="Newmarket's Premier Martial Arts Dojo"
    headline="Practical Martial Arts."
    accentLine="No Fluff."
    body="Newmarket's home for high-standard Karate and Brazilian Jiu-Jitsu. Proven real-world health and self-defence practices for adults, youths, and kids."
    bullets={['No commitment required', 'First class free', 'Limited beginner spots']}
    primaryCta={{ label: 'Claim Your Free Trial', href: '/trial' }}
    secondaryCta={{ label: 'View Schedule', href: '/schedule' }}
    bgImage="/images/hero-dojo.webp"
  />

  <CredentialsStrip />

  <!-- Programs — bento grid layout -->
  <section class="relative py-20 bg-charcoal overflow-hidden">
    <AnimatedBg />
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="mb-10 reveal">
        <Badge label="What We Teach" class="mb-4 block" />
        <h2 class="text-4xl font-semibold tracking-tight mb-3">Our Classes</h2>
        <p class="text-white/60 max-w-2xl">Precision training for adults, youths, and kids in Karate and BJJ.</p>
      </div>

      <div class="bento-grid">
        <!-- Karate — large tile -->
        <div class="bento-karate group relative overflow-hidden border-t-2 border-accent tilt-card reveal">
          <span class="kanji-bento" aria-hidden="true">空</span>
          <img
            src="/images/charlotte-roundhouse-QFzAmO1THZeA6cRQ.jpg"
            alt="Karate class at Jitsu-Do"
            class="absolute inset-0 w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700"
            loading="lazy"
            width="900"
            height="600"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent"></div>
          <div class="absolute bottom-0 left-0 p-8">
            <h3 class="font-display text-3xl uppercase tracking-wide mb-3">Karate</h3>
            <p class="text-sm text-white/65 mb-5 max-w-[38ch] leading-relaxed">
              Technical Chito-Ryu Karate built on discipline, precision, and real-world self-defence.
            </p>
            <a href="/karate" class="inline-flex items-center gap-2 font-mono text-xs tracking-[0.2em] uppercase text-accent hover:text-white transition-colors">
              Explore Karate
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>

        <!-- BJJ — medium tile -->
        <div class="bento-bjj group relative overflow-hidden border-t-2 border-accent tilt-card reveal">
          <span class="kanji-bento" aria-hidden="true">柔</span>
          <img
            src="/images/cameron-choking-maddox-7HNaQ3ZlUPmaWX2a.jpg"
            alt="BJJ class at Jitsu-Do"
            class="absolute inset-0 w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700"
            loading="lazy"
            width="600"
            height="600"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>
          <div class="absolute bottom-0 left-0 p-6">
            <h3 class="font-display text-2xl uppercase tracking-wide mb-2">Brazilian Jiu-Jitsu</h3>
            <a href="/bjj" class="inline-flex items-center gap-2 font-mono text-xs tracking-[0.2em] uppercase text-accent hover:text-white transition-colors">
              Explore BJJ
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>

        <!-- Stat tile -->
        <div class="bento-stat flex flex-col items-center justify-center text-center p-8 border-t-2 border-gold/40 reveal" style="background: linear-gradient(135deg, #1a1a1a 0%, #222 100%);">
          <span class="font-mono font-bold leading-none" style="color: #c8a96e; font-size: 1.25rem; letter-spacing: 0.1em;">EST.</span>
          <span class="font-mono text-5xl font-bold leading-none" style="color: #c8a96e;">2009</span>
        </div>

        <!-- CTA tile -->
        <div class="bento-cta flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 p-8 border border-white/10 reveal" style="background: linear-gradient(135deg, #1a1212 0%, #201616 100%);">
          <div>
            <p class="font-display text-2xl uppercase tracking-wide mb-1">First Class Free</p>
            <p class="text-sm text-white/50">No commitment · No pressure · See what real training feels like</p>
          </div>
          <Button href="/trial" variant="primary">Book Free Trial</Button>
        </div>
      </div>

      <div class="mt-10 flex justify-center reveal">
        <Button href="/schedule" variant="ghost">View Full Schedule</Button>
      </div>
    </div>
  </section>

  <PhilosophyStatement
    quote="The goal is not to defeat an opponent. It is to master yourself."
    author="Sensei Michael Ginn · Jitsu-Do Karate"
  />

  <FAQAccordion
    eyebrow="Before You Start"
    heading="Common Questions"
    items={faqItems}
  />

  <ReviewSection
    eyebrow="What People Say"
    heading="Reviews"
    featured={featuredReview}
    reviews={reviews}
  />

  <Gallery
    eyebrow="Inside the Dojo"
    heading="Our Academy"
    images={galleryImages}
  />

  <CTABand
    eyebrow="You're Entitled To A Free Trial"
    heading="Come Train With Us"
    body="No commitment. No pressure. See what a technical martial arts environment actually feels like."
    primaryCta={{ label: 'Book Free Trial', href: '/trial' }}
    secondaryCta={{ label: 'Contact Us', href: '/contact' }}
    bgImage="/images/hero-dojo.webp"
  />
</Layout>

<style>
  /* ── Kanji bento decoration ─────────────────────────────────────────────── */
  .kanji-bento {
    position: absolute;
    font-family: 'Hiragino Mincho ProN', 'Yu Mincho', 'BIZ UDMincho', 'Noto Serif CJK JP', Georgia, serif;
    font-size: clamp(140px, 22vw, 340px);
    font-weight: 900;
    line-height: 1;
    top: 50%;
    right: 4%;
    transform: translateY(-50%);
    opacity: 0.22;
    color: #c8a96e;
    user-select: none;
    pointer-events: none;
    z-index: 2;
    letter-spacing: 0;
  }

  /* ── Bento grid ─────────────────────────────────────────────────────────── */
  .bento-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  .bento-karate,
  .bento-bjj {
    position: relative;
    min-height: 320px;
  }

  .bento-stat,
  .bento-cta {
    min-height: 160px;
  }

  @media (min-width: 768px) {
    .bento-grid {
      grid-template-columns: 1fr 1fr 1fr;
      grid-template-rows: 300px 300px auto;
    }

    .bento-karate {
      grid-column: 1 / 3;
      grid-row: 1 / 3;
      min-height: unset;
    }

    .bento-bjj {
      grid-column: 3 / 4;
      grid-row: 1 / 2;
      min-height: unset;
    }

    .bento-stat {
      grid-column: 3 / 4;
      grid-row: 2 / 3;
      min-height: unset;
    }

    .bento-cta {
      grid-column: 1 / 4;
      grid-row: 3 / 4;
      min-height: unset;
    }
  }
</style>
