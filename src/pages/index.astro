---
import Layout from '../layouts/Layout.astro';
import { business } from '../data/business';
---
<Layout
  title={business.name}
  description="Karate and Brazilian Jiu-Jitsu in Newmarket, Ontario. Founded 2009."
>
  <main class="min-h-screen flex items-center justify-center p-8">
    <div class="text-center">
      <h1 class="text-5xl font-display tracking-wide mb-4">{business.name}</h1>
      <p class="text-lg opacity-70">Phase 1 scaffold complete. Site under reconstruction.</p>
    </div>
  </main>
</Layout>
