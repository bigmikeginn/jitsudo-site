---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import CTABand from '../components/sections/CTABand.astro';

export async function getStaticPaths() {
  // All current pages have dedicated .astro files — this catch-all is a fallback for any new
  // markdown pages added to /content/pages later.
  const excluded = [
    'home', 'about', 'karate', 'bjj', 'programs',
    'kids-programs', 'youth-programs', 'adult-programs',
    'trial', 'contact', 'schedule', 'join', 'shop',
  ];
  const pages = await getCollection('pages');
  return pages
    .filter((p) => !excluded.includes(p.id))
    .map((page) => ({
      params: { slug: page.id },
      props: { page },
    }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---
<Layout
  title={`${page.data.title} — Jitsu-Do Karate`}
  description={page.data.description}
  ogImage={page.data.ogImage}
  noindex={page.data.noindex}
>
  <Hero
    eyebrow="Jitsu-Do Karate"
    headline={page.data.title}
    body={page.data.description}
    minHeight="min-h-[40vh]"
  />

  <article class="bg-black py-16 px-4">
    <div class="max-w-3xl mx-auto prose">
      <Content />
    </div>
  </article>

  <CTABand
    eyebrow="Take the next step"
    heading="Ready to train?"
    body="Book a free trial class. No experience or equipment needed."
    primaryCta={{ label: 'Book Free Trial', href: '/trial' }}
    secondaryCta={{ label: 'View Schedule', href: '/schedule' }}
  />
</Layout>
