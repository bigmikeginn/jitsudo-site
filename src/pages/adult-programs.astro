---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import Badge from '../components/ui/Badge.astro';
import CTABand from '../components/sections/CTABand.astro';
import AnimatedBg from '../components/ui/AnimatedBg.astro';
import FAQAccordion from '../components/sections/FAQAccordion.astro';
import { startingPriceLabel } from '../data/pricing';

const adultFaq = [
  {
    question: 'What is the class format?',
    answer: 'Adult classes run Monday–Friday evenings (5:00–8:15pm) and Saturday mornings (8:30–11:30am), 60 minutes each, mixing Karate and BJJ across the week. No age cutoff — adults of any age train together, grouped by experience and belt level for partner work.',
  },
  {
    question: 'What does a first class look like?',
    answer: 'You\'ll get a short one-on-one orientation with Shihan Ginn before joining the floor, covering stance, movement, and etiquette. You\'ll train alongside the group for warm-up and basic technique drilling with a partner matched to your experience level. No sparring or live rolling in your first class — that comes once fundamentals are solid.',
  },
  {
    question: 'What should I wear and bring?',
    answer: 'Comfortable athletic clothing is fine for a trial class — no gi required. Bare feet on the mat, a water bottle, and a mouthguard once you start live BJJ rolling. A gi is required once you enroll and is available through our store, with a 15% discount for Elite members.',
  },
  {
    question: 'What is the typical progression and goals?',
    answer: 'You\'ll grade for belts on a demonstrated-skill cycle, not a fixed schedule. Most adults spend their first several months on stance, structure, and positional BJJ fundamentals before live sparring and rolling become a regular part of class. Elite members add a monthly private lesson to accelerate specific weak points.',
  },
  {
    question: 'How is safety and supervision handled?',
    answer: 'All sparring and rolling is supervised directly by Shihan Ginn or a senior instructor and matched by size, experience, and control — never left unsupervised. Contact and intensity increase gradually as your technique and control develop.',
  },
  {
    question: 'Is this a good fit if I have no experience?',
    answer: 'Yes — most adult students start with zero martial arts background. The program is built for the complete beginner just as much as the returning practitioner; you\'ll never be thrown into live sparring before you\'re ready.',
  },
];

const audiences = [
  {
    label: 'Complete Beginners',
    body: 'No prior experience required. Adults at every fitness level are welcomed into the curriculum.',
  },
  {
    label: 'Returning Martial Artists',
    body: 'Had training years ago? We bring experienced students up to speed without repeating the basics.',
  },
  {
    label: 'Fitness-Minded Adults',
    body: 'High-standard technical training that improves strength, flexibility, and coordination at any age.',
  },
  {
    label: 'Those Who Want Real Skills',
    body: 'Not cardio, not trophies. Practical, pressure-tested ability built over time in a structured environment.',
  },
];
---
<Layout
  title="Adult Martial Arts — Jitsu-Do Newmarket"
  description="Adult karate and BJJ in Newmarket for busy professionals. Real-world skills, no fluff. Flexible schedule — Mon-Fri evenings, Sat mornings."
>
  <Hero
    eyebrow="Adults · Newmarket"
    headline="Adult Martial Arts"
    accentLine="& Technical BJJ"
    body="High-standard Karate and BJJ for adults. No fluff, no ego — just technical training for the professional practitioner."
    primaryCta={{ label: 'Book Free Trial', href: '/trial' }}
    secondaryCta={{ label: 'View Schedule', href: '/schedule' }}
    bgImage="/images/sensei-teaching-throw.webp"
    minHeight="min-h-[70vh]"
  />

  <section class="relative py-20 bg-charcoal overflow-hidden">
    <AnimatedBg />
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <Badge label="The Standard" class="mb-4 block" />
      <h2 class="text-4xl font-semibold tracking-tight mb-8">Neither Cardio Nor Combat Sport</h2>
      <p class="text-white/75 leading-relaxed mb-6">
        Most adult programs are either <strong class="text-white">cardio-kickboxing disguised as martial arts</strong> or high-ego competition stables. Jitsu-Do is neither.
      </p>
      <p class="text-white/75 leading-relaxed">
        We offer a technical environment for the professional practitioner who demands high-standard instruction without the fluff. Class times are built around adult schedules — Monday–Friday evenings and Saturday mornings.
      </p>
    </div>
  </section>

  <section class="relative py-20 bg-surface overflow-hidden">
    <AnimatedBg />
    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <Badge label="Stand-Up Game" class="mb-4 block" />
        <h3 class="text-3xl font-semibold tracking-tight mb-6">Karate: Structural Power</h3>
        <p class="text-white/75 leading-relaxed mb-4">
          We use the foundations of Okinawan Karate to master <strong class="text-white">distance, timing, and structural integrity</strong>. You'll develop power that comes from mechanical advantage — not size or strength.
        </p>
        <p class="text-white/70 leading-relaxed">
          Combined with elements of judo, ju-jitsu, and kickboxing, the result is a complete striking and control system.
        </p>
      </div>
      <div class="aspect-[4/3] overflow-hidden">
        <img
          src="/images/james-bo-close.webp"
          alt="James van Kessel with bo staff at Jitsu-Do"
          class="w-full h-full object-cover grayscale saturate-50"
          loading="lazy"
          width="800"
          height="600"
        />
      </div>
    </div>
  </section>

  <section class="relative py-20 bg-photo-parallax overflow-hidden">
    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="aspect-[4/3] overflow-hidden order-2 lg:order-1">
        <img
          src="/images/mount.webp"
          alt="BJJ mount position at Jitsu-Do"
          class="w-full h-full object-cover grayscale saturate-50"
          loading="lazy"
          width="800"
          height="600"
        />
      </div>
      <div class="order-1 lg:order-2">
        <Badge label="Ground Game" class="mb-4 block" />
        <h3 class="text-3xl font-semibold tracking-tight mb-6">BJJ: The Ground Truth</h3>
        <p class="text-white/75 leading-relaxed mb-4">
          Brazilian Jiu-Jitsu at Jitsu-Do emphasizes <strong class="text-white">technical efficiency over athletic talent</strong>.
        </p>
        <p class="text-white/70 leading-relaxed">
          You don't need strength to succeed — you need leverage, timing, and positional awareness. The kind of skill that improves with age, not the kind that fades.
        </p>
      </div>
    </div>
  </section>

  <section class="relative py-14 bg-surface overflow-hidden">
    <AnimatedBg />
    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <Badge label="Right Fit" class="mb-4 block mx-auto" />
        <h3 class="text-3xl font-semibold tracking-tight">Built For The Professional Practitioner</h3>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-10">
        {audiences.map((a) => (
          <div class="bg-surface-2 border border-white/10 p-6">
            <h4 class="font-mono text-sm tracking-[0.2em] uppercase text-accent mb-3">{a.label}</h4>
            <p class="text-white/70 leading-relaxed text-sm">{a.body}</p>
          </div>
        ))}
      </div>
      <p class="text-white/50 text-sm text-center">Memberships from <a href="/schedule" class="text-accent hover:text-white transition-colors">{startingPriceLabel}</a>.</p>
    </div>
  </section>

  <FAQAccordion
    eyebrow="What to Expect"
    heading="Before Your First Class"
    items={adultFaq}
  />

  <CTABand
    eyebrow="Claim your free trial"
    heading="Just Come Train"
    body="No commitment. No pressure. Mon–Fri 5:00–8:15pm or Sat 8:30–11:30am — pick a time and we'll see you on the mat."
    primaryCta={{ label: 'Book Free Trial', href: '/trial' }}
    secondaryCta={{ label: 'View The Schedule', href: '/schedule' }}
  />
</Layout>
