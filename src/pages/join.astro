---
import Layout from '../layouts/Layout.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import AnimatedBg from '../components/ui/AnimatedBg.astro';
import { plans as pricingPlans } from '../data/pricing';

const REGISTER_URL = 'https://jitsu-do-karate.gymdesk.com/register';

const steps = [
  {
    num: '01',
    title: 'Book a Free Trial',
    body: 'Every new student starts here. Pick a trial class from our schedule — no commitment, no gear required.',
    cta: { label: 'Book Free Trial', href: '/trial' },
  },
  {
    num: '02',
    title: 'Choose Your Membership',
    body: 'After your trial, choose the plan that fits your goals — Basic, Core, or Elite. View pricing on the schedule page.',
    cta: { label: 'See Pricing', href: '/schedule' },
  },
  {
    num: '03',
    title: 'Register Through Gymdesk',
    body: 'Complete your membership registration securely through our member portal. Takes 2 minutes.',
    cta: { label: 'Register Now', href: REGISTER_URL },
  },
];

const plans = pricingPlans.map((plan) => ({
  name: plan.name,
  price: `${plan.price}${plan.cadence}`,
  note: plan.note,
  highlight: plan.highlighted,
}));
---
<Layout
  title="Join — Jitsu-Do Karate Newmarket"
  description="Ready to start training at Jitsu-Do? Book a free trial, choose your membership, and register through Gymdesk. No contracts on Core."
>

  <!-- Hero — no background image, clean animated bg -->
  <section class="relative flex items-end overflow-hidden min-h-[55vh]">
    <AnimatedBg variant="hero" />
    <div
      class="absolute inset-0 pointer-events-none"
      aria-hidden="true"
      style="background: radial-gradient(ellipse 55% 50% at 18% 72%, rgba(196,30,30,0.16) 0%, transparent 65%);"
    ></div>
    <div class="relative z-10 w-full max-w-[1360px] mx-auto px-[clamp(20px,4vw,64px)] pb-[clamp(56px,9vh,112px)] pt-24">
      <div class="mb-6">
        <Badge label="Get Started" />
      </div>
      <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl uppercase leading-[0.92] tracking-[-0.01em] max-w-[16ch] mb-0">
        Join
      </h1>
      <p class="font-display text-5xl sm:text-6xl lg:text-7xl uppercase leading-[0.92] tracking-[-0.01em] text-accent mb-6">
        Jitsu-Do
      </p>
      <div class="hero-body mt-6 mb-8">
        <p class="text-lg text-white/90 max-w-[52ch] leading-relaxed">
          High-standard Karate and BJJ in Newmarket. Every student starts with a free trial — no pressure, no contracts, no hidden fees.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-4">
        <Button href="/trial" variant="primary">Book Free Trial</Button>
        <Button href={REGISTER_URL} variant="ghost">Register as Member</Button>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="relative py-20 bg-charcoal overflow-hidden">
    <AnimatedBg />
    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <Badge label="How It Works" class="mb-4 block" />
      <h2 class="text-4xl font-semibold tracking-tight mb-14">Three Steps to the Mat</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {steps.map((step) => (
          <div class="flex flex-col">
            <span class="font-mono text-5xl text-accent/25 font-bold leading-none mb-4">{step.num}</span>
            <h3 class="text-lg font-semibold tracking-tight mb-3">{step.title}</h3>
            <p class="text-sm text-white/65 leading-relaxed mb-6 flex-1">{step.body}</p>
            <Button href={step.cta.href} variant="ghost" size="sm">{step.cta.label}</Button>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quick pricing summary -->
  <section class="relative py-20 bg-surface overflow-hidden">
    <AnimatedBg />
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <Badge label="Membership Tiers" class="mb-4 block" />
      <h2 class="text-4xl font-semibold tracking-tight mb-4">Pick Your Level</h2>
      <p class="text-white/60 text-sm mb-10">All plans include Karate and BJJ. <a href="/schedule" class="text-accent hover:text-white transition-colors">Full pricing details →</a></p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
        {plans.map((plan) => (
          <div class={`border ${plan.highlight ? 'border-accent bg-accent/5' : 'border-white/10 bg-surface-2'} p-6`}>
            <h3 class={`text-xl font-semibold mb-1 ${plan.highlight ? 'text-accent' : ''}`}>{plan.name}</h3>
            <p class="font-display text-2xl mb-2">{plan.price}</p>
            <p class="text-xs text-white/50 leading-relaxed">{plan.note}</p>
          </div>
        ))}
      </div>
      <div class="flex flex-wrap gap-4">
        <Button href={REGISTER_URL} variant="primary" size="lg">Register Through Gymdesk</Button>
        <Button href="/schedule" variant="ghost" size="lg">Full Pricing Details</Button>
      </div>
    </div>
  </section>

  <!-- Not ready yet? -->
  <section class="relative py-16 bg-charcoal overflow-hidden">
    <AnimatedBg />
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
      <div>
        <Badge label="New Student?" class="mb-4 block" />
        <h2 class="text-3xl font-semibold tracking-tight mb-4">Start With a Free Trial</h2>
        <p class="text-white/70 leading-relaxed mb-6">
          Not sure yet? Come in for a no-commitment trial class. Meet Shihan Ginn, train alongside the group, and decide from there.
        </p>
        <Button href="/trial" variant="primary">Book Free Trial</Button>
      </div>
      <div>
        <Badge label="Have Questions?" class="mb-4 block" />
        <h2 class="text-3xl font-semibold tracking-tight mb-4">Talk To Us First</h2>
        <p class="text-white/70 leading-relaxed mb-6">
          Not sure which program is right for your age or goals? Reach out — we'll help you figure out the best starting point.
        </p>
        <Button href="/contact" variant="ghost">Contact Us</Button>
      </div>
    </div>
  </section>

</Layout>

<style>
  .hero-body {
    border-left: 2px solid rgba(200, 169, 110, 0.65);
    padding-left: 1.25rem;
    background: linear-gradient(90deg, rgba(200,169,110,0.06) 0%, transparent 70%);
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
  }
</style>
