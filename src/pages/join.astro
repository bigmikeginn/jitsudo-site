---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import CTABand from '../components/sections/CTABand.astro';
import AnimatedBg from '../components/ui/AnimatedBg.astro';

const REGISTER_URL = 'https://jitsu-do-karate.gymdesk.com/register';

const reasons = [
  { title: 'Experience The Culture', body: 'A trial gives you a true feel for the environment, the teaching style, and the community before making any commitment.' },
  { title: 'Low-Stakes Exploration', body: 'The ultimate test drive. Explore a new skill without the pressure of a contract or upfront investment.' },
  { title: 'Meet Your Instructor', body: 'Building rapport with a coach is vital. See if Shihan Ginn\'s communication style aligns with how you learn best.' },
  { title: 'Assess The Physical Fit', body: 'Understand the physical demands and pace of the program to ensure it matches your current goals.' },
  { title: 'Clarify Your Goals', body: 'Sometimes you don\'t know what you\'re looking for until you\'re on the floor. A trial helps you identify what excites you most.' },
  { title: 'No Pressure', body: 'Senior students will be on the floor to welcome you. Beginners train alongside others who remember exactly what day one feels like.' },
];
---
<Layout
  title="Join — Jitsu-Do Karate Newmarket"
  description="Ready to start training? Register your free trial through Gymdesk. No contracts, no fees — just show up."
>
  <Hero
    eyebrow="No Commitment Required"
    headline="Claim Your"
    accentLine="Free Trial"
    body="Register through Gymdesk. No contracts. No hidden fees. Just high-standard, technical training in Newmarket."
    bullets={['No credit card required', 'No long-term contract', 'First class completely free']}
    primaryCta={{ label: 'Register Now', href: REGISTER_URL }}
    secondaryCta={{ label: 'See What To Bring', href: '/trial' }}
    bgImage="/images/membership-card-NFo6fOw1askrefq8.png"
    minHeight="min-h-[70vh]"
  />

  <section class="relative py-20 bg-black overflow-hidden">
    <AnimatedBg />
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Badge label="Why Trials Matter" class="mb-4 block" />
      <h2 class="font-display text-4xl uppercase tracking-wide mb-12">What To Expect</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {reasons.map((r) => (
          <div class="bg-surface border border-white/8 p-6">
            <h3 class="font-display text-sm tracking-widest uppercase text-accent mb-3">{r.title}</h3>
            <p class="text-sm text-white/70 leading-relaxed">{r.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 bg-surface text-center px-4">
    <Badge label="Ready?" class="mb-4 block" />
    <h2 class="font-display text-4xl uppercase tracking-wide mb-4">Spots In Beginner Classes Are Limited</h2>
    <p class="text-white/70 mb-10 max-w-xl mx-auto">Register now through Gymdesk to secure your free trial class.</p>
    <div class="flex flex-wrap items-center justify-center gap-4">
      <Button href={REGISTER_URL} variant="primary" size="lg">Register Now</Button>
      <Button href="/trial" variant="ghost" size="lg">See What To Bring</Button>
    </div>
  </section>

  <CTABand
    eyebrow="Questions first?"
    heading="Talk To Us"
    body="Still figuring it out? Reach out and we'll help you find the right starting point."
    primaryCta={{ label: 'Contact Us', href: '/contact' }}
    secondaryCta={{ label: 'View Schedule', href: '/schedule' }}
  />
</Layout>
