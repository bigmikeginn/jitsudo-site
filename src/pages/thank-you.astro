---
import Layout from '../layouts/Layout.astro';
import CTABand from '../components/sections/CTABand.astro';
import AnimatedBg from '../components/ui/AnimatedBg.astro';
---
<Layout
  title="Message Sent — Jitsu-Do Karate Newmarket"
  description="Thank you for contacting Jitsu-Do Karate. We'll reply within one business day."
  noindex={true}
>
  <section class="relative flex items-center justify-center min-h-[70vh] bg-charcoal overflow-hidden">
    <AnimatedBg />
    <div class="relative z-10 text-center px-4 max-w-xl mx-auto">
      <div class="mb-8 inline-flex items-center justify-center w-16 h-16 rounded-full border border-white/20 bg-white/5">
        <svg class="w-8 h-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
        </svg>
      </div>
      <h1 class="font-display text-4xl md:text-5xl uppercase tracking-wide mb-4">Message Sent</h1>
      <p class="text-white/70 text-lg mb-8">
        Thanks for reaching out. We reply within one business day — usually sooner.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/"
          class="inline-block bg-accent text-white px-8 py-4 text-sm font-display tracking-widest uppercase hover:bg-red-800 transition-colors"
        >
          Back to Home
        </a>
        <a
          href="/schedule"
          class="inline-block border border-white/30 text-white px-8 py-4 text-sm font-display tracking-widest uppercase hover:border-white hover:bg-white/5 transition-colors"
        >
          View Schedule
        </a>
      </div>
    </div>
  </section>

  <CTABand
    eyebrow="New students"
    heading="Ready to try a class?"
    body="Your first class is free. No gear, no contracts — just come in and train."
    primaryCta={{ label: 'Book Free Trial', href: '/trial' }}
  />
</Layout>
