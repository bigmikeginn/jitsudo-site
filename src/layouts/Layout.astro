---
import '@fontsource/aldrich';
import '@fontsource-variable/inter';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import { business } from '../data/business';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import GrainOverlay from '../components/ui/GrainOverlay.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  bare?: boolean;
}

const { title, description, ogImage, noindex = false, bare = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? `https://${business.domain}`);

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "SportsActivityLocation",
  "name": business.name,
  "url": `https://${business.domain}`,
  "telephone": business.phone,
  "email": business.email,
  "description": "Jitsu-Do Karate + BJJ is a technical martial arts school in Newmarket, Ontario offering Chito-Ryu Karate and Gracie Humaita Brazilian Jiu-Jitsu for kids, youth, and adults.",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": business.address.street,
    "addressLocality": business.address.city,
    "addressRegion": business.address.region,
    "postalCode": business.address.postalCode,
    "addressCountry": business.address.country,
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 44.05864,
    "longitude": -79.42382,
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
      "opens": "17:00",
      "closes": "20:15",
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": "Saturday",
      "opens": "08:30",
      "closes": "11:30",
    },
  ],
  "priceRange": "$$",
  "image": `https://${business.domain}/images/karate-logo-white-text-oHuRP0peEmmhqRFY.png`,
  "sameAs": [
    `https://${business.domain}`,
  ],
  "hasMap": "https://www.google.com/maps/search/?api=1&query=1211+Gorham+Street+Unit+5+Newmarket+Ontario",
  "areaServed": {
    "@type": "City",
    "name": "Newmarket",
    "containedInPlace": {
      "@type": "State",
      "name": "Ontario",
    },
  },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.toString()} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- LocalBusiness structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  </head>
  <body class="bg-brand-bg font-sans antialiased" style="color: #f0ede6;">
    <!-- Cursor spotlight — red radial glow that follows mouse, desktop only -->
    <div id="cursor-spotlight" aria-hidden="true"></div>
    <GrainOverlay />
    <a href="#main-content" class="skip-link">Skip to content</a>
    {!bare && <Header />}
    <main id="main-content">
      <slot />
    </main>
    {!bare && <Footer />}
    <script>
      import '../scripts/scroll-reveal.js';
      import '../scripts/card-tilt.js';
    </script>
    <script>
      // Cursor spotlight — only on precise pointer devices (mouse, not touch)
      if (window.matchMedia('(pointer: fine)').matches) {
        const el = document.getElementById('cursor-spotlight');
        if (el) {
          let raf: number | null = null;
          let mx = -9999, my = -9999;
          document.addEventListener('mousemove', (e) => {
            mx = e.clientX; my = e.clientY;
            if (!raf) raf = requestAnimationFrame(() => {
              el.style.setProperty('--sx', mx + 'px');
              el.style.setProperty('--sy', my + 'px');
              raf = null;
            });
          }, { passive: true });
        }
      }
    </script>
  </body>
</html>
